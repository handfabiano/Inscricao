# =====================================================
# Configurações do Sistema
# =====================================================
# Copie este arquivo para .env e ajuste as configurações

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inscricao_esportiva
DB_USER=root
DB_PASS=

# Redis Cache (opcional - fallback para arquivos se não disponível)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Memcached (opcional)
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# Cache
CACHE_PREFIX=eventos:
CACHE_DEFAULT_TTL=3600

# Payment Encryption
# IMPORTANTE: Gere uma chave segura para produção
# Pode usar: openssl rand -base64 32
PAYMENT_ENCRYPTION_KEY=CHANGE_THIS_IN_PRODUCTION_USE_RANDOM_KEY

# Application
APP_NAME="Sistema de Gestão de Eventos Esportivos"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Security
SESSION_LIFETIME=120
CSRF_TOKEN_LIFETIME=86400

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@eventos.com.br
MAIL_FROM_NAME="${APP_NAME}"

# API
API_RATE_LIMIT_DEFAULT=100
API_RATE_LIMIT_WINDOW=60

# File Upload
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# Logging
LOG_LEVEL=debug
LOG_FILE=storage/logs/app.log

# 2FA
TWO_FACTOR_ISSUER="${APP_NAME}"
TRUSTED_DEVICE_DURATION_DAYS=30
